cff-version: 1.2.0
message: "If you use this software, please cite it as below."
title: "logvalue"
abstract: >-
  A feature-analysis harness that measures the diagnostic value of individual
  log templates against real failure ground truth, and tests whether static
  log-quality analysis predicts runtime log utility.
type: software
version: 0.1.0
date-released: "2026-10-17"
license: MIT
repository-code: "https://github.com/dgexplores/logvalue"
authors:
  - family-names: "DG"
    alias: "dgexplores"
keywords:
  - log analysis
  - observability
  - feature analysis
  - discriminative power
  - log template mining
  - software engineering

preferred-citation:
  type: software
  title: "logvalue: Measuring the diagnostic value of log statements"
  authors:
    - family-names: "DG"
      alias: "dgexplores"
  year: 2026
  version: 0.1.0
  license: MIT

